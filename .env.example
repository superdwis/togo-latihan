NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_API_KEY=replace-with-a-long-random-secret
OPENROUTER_API=your-openrouter-api-key

# BuatQris — server-only credentials. Never use NEXT_PUBLIC_ for secrets.
BUATQRIS_API_URL=https://api.buatqris.site
BUATQRIS_MODE=test
# Open API credentials from the BuatQris dashboard.
BUATQRIS_ACCOUNT_ID=
BUATQRIS_SECRET_TOKEN=
# Signing Secret from BuatQris → Open API → Webhook / Callback.
BUATQRIS_SIGNING_SECRET=
# Supabase secret key (sb_secret_...); required only by the server webhook receiver.
SUPABASE_SECRET_KEY=

# Configure this public URL in the BuatQris dashboard after deployment:
# https://your-domain.example/api/webhooks/buatqris
